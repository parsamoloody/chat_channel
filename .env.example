# Database connection (PostgreSQL URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chat_channel_dev?schema=public"

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# Telegram Bot Username without @ (e.g. MySecretChatBot)
TELEGRAM_BOT_USERNAME="your_bot_username"

NODE_ENV=development

# Media Upload Rate Limit & File Size Limit Configuration
# Enable or disable media rate limiting ("true" or "false")
MEDIA_RATE_LIMIT_ENABLED=false
# Enable or disable media file size limit ("true" or "false")
MEDIA_FILE_SIZE_LIMIT_ENABLED=false
# Maximum count of media (stickers, gifs, emojis, etc.) allowed per time window
MEDIA_RATE_LIMIT_COUNT=10
# Time unit for media limit: "sec", "min", "hour", "day"
MEDIA_RATE_LIMIT_UNIT="hour"
# Multiplier for unit (e.g. 1 for 1 hour, 2 for 2 hours, 30 for 30 min)
MEDIA_RATE_LIMIT_PERIOD=1
# Maximum file size allowed for media uploads in megabytes (defaults to 5MB)
MEDIA_MAX_FILE_SIZE_MB=5
